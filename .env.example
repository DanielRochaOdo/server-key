VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Functions (Secrets do Supabase; nunca use o prefixo VITE_)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Desenvolvimento local das Edge Functions
